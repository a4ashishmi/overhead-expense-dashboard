<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>O/H Expense Dashboard | Jan–Aug 2026</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.5/dist/chart.umd.min.js"></script>
  <style>
    :root { --ink:#12233f; --muted:#66758a; --blue:#1769aa; --blue2:#77aeda; --pale:#eaf4fc; --peach:#f6c6a2; --gray:#aeb7c4; --line:#dfe7ef; --green:#218b69; --bg:#f5f8fb; }
    * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; font-family:Inter,Segoe UI,Arial,sans-serif; color:var(--ink); background:var(--bg); }
    .shell { max-width:1440px; margin:auto; padding:0 28px 42px; }
    .top { background:#fff; border-bottom:1px solid var(--line); position:sticky; top:0; z-index:5; box-shadow:0 5px 18px #12233f0a; }
    .nav { max-width:1440px; margin:auto; height:70px; padding:0 28px; display:flex; align-items:center; justify-content:space-between; gap:16px; }
    .brand { font-weight:800; letter-spacing:.2px; color:var(--blue); } .brand span { color:var(--ink); font-weight:600; }
    .navlinks { display:flex; gap:20px; } .navlinks a { color:var(--muted); text-decoration:none; font-weight:650; font-size:14px; } .navlinks a:hover { color:var(--blue); }
    .hero { padding:38px 0 25px; display:flex; justify-content:space-between; align-items:end; gap:22px; }
    .eyebrow { font-size:13px; text-transform:uppercase; color:var(--blue); font-weight:800; letter-spacing:1.2px; } h1 { margin:8px 0 7px; font-size:34px; letter-spacing:-.8px; } .sub { margin:0; color:var(--muted); font-size:16px; }
    .stamp { text-align:right; font-size:14px; color:var(--muted); line-height:1.5; } .stamp b { color:var(--ink); }
    .kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
    .kpi { background:#fff; border:1px solid var(--line); border-radius:14px; padding:19px 20px; min-height:132px; position:relative; overflow:hidden; box-shadow:0 4px 12px #12233f08; animation:rise .55s both; }
    .kpi:nth-child(2){animation-delay:.08s}.kpi:nth-child(3){animation-delay:.16s}.kpi:nth-child(4){animation-delay:.24s} .kpi:before{content:"";position:absolute;left:0;top:0;width:4px;height:100%;background:var(--blue)} .kpi .label{font-size:14px;color:var(--muted);font-weight:700}.kpi .value{font-size:31px;font-weight:800;letter-spacing:-1px;margin:12px 0 5px}.kpi .meta{font-size:13px;color:var(--muted)}.kpi .good{color:var(--green);font-weight:800}
    .section { padding-top:35px; scroll-margin-top:74px; } .section-head { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:14px; } h2{font-size:22px;margin:0}.section-head p{margin:0;color:var(--muted);font-size:14px}
    .grid2 { display:grid; grid-template-columns:1.12fr .88fr; gap:16px; }.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px;box-shadow:0 4px 12px #12233f08}.card h3{font-size:16px;margin:0 0 2px}.note{color:var(--muted);font-size:13px;margin:4px 0 16px}.chart-wrap{height:290px;position:relative}.small-chart{height:240px;position:relative}
    .insight{background:linear-gradient(135deg,#1769aa,#2d86c4);color:#fff;border-radius:14px;padding:22px;display:flex;flex-direction:column;justify-content:space-between}.insight .big{font-size:38px;font-weight:800;margin:12px 0 0}.insight p{font-size:14px;line-height:1.5;margin:5px 0;color:#e9f4ff}.insight a{color:#fff;font-size:13px;font-weight:750;margin-top:14px}
    table{width:100%;border-collapse:collapse;font-size:13px}th{text-align:right;background:var(--pale);padding:11px 10px;color:#45627d;font-weight:750}td{padding:10px;border-bottom:1px solid var(--line);text-align:right;color:#31445c}th:first-child,td:first-child{text-align:left}tr:last-child td{border-bottom:0;font-weight:800;background:#f6fbff}.pos{color:var(--green);font-weight:750}.neg{color:#bc4d54;font-weight:750}.progress{height:8px;background:#e8eef5;border-radius:99px;overflow:hidden;margin:8px 0 3px}.progress i{display:block;height:100%;background:var(--blue);border-radius:99px}.pill{display:inline-block;border-radius:99px;padding:4px 8px;background:#e6f5ee;color:#187657;font-size:11px;font-weight:800}.links{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.btn{border:1px solid #bdd7ec;padding:9px 12px;border-radius:8px;color:var(--blue);font-size:13px;font-weight:750;text-decoration:none;background:#f7fbff}.btn:hover{background:var(--pale)}footer{color:#718197;font-size:12px;text-align:center;padding-top:30px}
    @keyframes rise{from{transform:translateY(13px);opacity:0}to{transform:none;opacity:1}} @media(max-width:900px){.kpis,.grid3{grid-template-columns:repeat(2,1fr)}.grid2{grid-template-columns:1fr}.hero{align-items:start;flex-direction:column}.stamp{text-align:left}}@media(max-width:600px){.shell,.nav{padding-left:16px;padding-right:16px}.navlinks{display:none}.kpis,.grid3{grid-template-columns:1fr}h1{font-size:28px}.chart-wrap{height:250px}}
  </style>
</head>
<body>
  <header class="top"><nav class="nav"><div class="brand">O/H <span>Expense Dashboard</span></div><div class="navlinks"><a href="#overview">Overview</a><a href="#expense">Expense details</a><a href="#projects">Project savings</a><a href="#actions">Actions</a></div></nav></header>
  <main class="shell">
    <section class="hero" id="overview"><div><div class="eyebrow">Executive performance view</div><h1>Overhead expense and savings</h1><p class="sub">January–August 2026 · Figures in M$ unless stated otherwise</p></div><div class="stamp">Reporting period: <b>Jan–Aug 2026</b><br/>Projects delivered: <b>1,052</b></div></section>
    <section class="kpis" aria-label="Key performance indicators">
      <article class="kpi"><div class="label">Total saving</div><div class="value">3.61 M$</div><div class="meta">Target 4.56 M$ · <span class="good">79% achieved</span></div></article>
      <article class="kpi"><div class="label">Project saving</div><div class="value">2.60 M$</div><div class="meta">Target 4.00 M$ · 65% achieved</div></article>
      <article class="kpi"><div class="label">Expense saving</div><div class="value">1.01 M$</div><div class="meta">M-Plan 3.78 M$ · Actual 2.77 M$</div></article>
      <article class="kpi"><div class="label">Investment saving</div><div class="value">3.20 M$</div><div class="meta">Reduction from 13.70 M$ to 10.50 M$</div></article>
    </section>
    <section class="section" id="expense"><div class="section-head"><div><h2>Expense details</h2><p>Actual expense is below plan across both tracked overhead accounts</p></div><p>Expense saving: <b>1.01 M$</b></p></div>
      <div class="grid3"><article class="card"><h3>Plan versus actual</h3><p class="note">Jan–Aug 2026</p><div class="small-chart"><canvas id="planActual"></canvas></div></article><article class="card"><h3>Monthly expense trend</h3><p class="note">M-Plan compared with actual expense</p><div class="small-chart"><canvas id="monthlyExpense"></canvas></div></article><aside class="insight"><div><div class="eyebrow" style="color:#d6ecff">Key observation</div><div class="big">27% ↓</div><p>Total actual expense was 1.01 M$ below the 3.78 M$ plan.</p></div><a href="#actions">View major activities and actions ↓</a></aside></div>
      <div class="card" style="margin-top:16px"><h3>Expense account detail</h3><p class="note">Savings equal M-Plan less actual. Negative monthly values indicate a temporary plan overrun.</p><table><thead><tr><th>GL account</th><th>Jan</th><th>Feb</th><th>Mar</th><th>Apr</th><th>May</th><th>Jun</th><th>Jul</th><th>Aug</th><th>Total</th></tr></thead><tbody><tr><td>Product supply · saving</td><td>0.08</td><td class="neg">(0.03)</td><td class="neg">(0.09)</td><td class="neg">(0.13)</td><td>0.09</td><td>0.13</td><td>0.09</td><td>0.01</td><td class="pos">0.15</td></tr><tr><td>Repair &amp; maintenance · saving</td><td>0.01</td><td>0.01</td><td>0.03</td><td>0.03</td><td>0.17</td><td>0.33</td><td>0.15</td><td>0.14</td><td class="pos">0.87</td></tr><tr><td>Total expense saving</td><td>0.09</td><td class="neg">(0.02)</td><td class="neg">(0.06)</td><td class="neg">(0.10)</td><td>0.26</td><td>0.46</td><td>0.24</td><td>0.14</td><td class="pos">1.01</td></tr></tbody></table></div></section>
    <section class="section" id="projects"><div class="section-head"><div><h2>Project cost saving</h2><p>Jan–Aug 2026 actual: 2.60 M$ against a 2.60 M$ period target</p></div><span class="pill">Period target achieved</span></div><div class="grid2"><article class="card"><h3>Cumulative project savings</h3><p class="note">Project savings build steadily through August</p><div class="chart-wrap"><canvas id="cumulative"></canvas></div></article><article class="card"><h3>Saving category mix</h3><p class="note">In-house repairing and part development is the largest contributor</p><div class="chart-wrap"><canvas id="categories"></canvas></div></article></div>
      <div class="card" style="margin-top:16px"><h3>Category performance</h3><p class="note">Jan–Aug 2026 project savings</p><table><thead><tr><th>Category</th><th>Y'25 result</th><th>Jan–Aug 2026</th><th>Share</th><th>Progress to 2.60 M$ target</th></tr></thead><tbody><tr><td>Localization / Re-bidding</td><td>1.51</td><td class="pos">0.54</td><td>20%</td><td><div class="progress"><i style="width:21%"></i></div>21%</td></tr><tr><td>Consumption reduction</td><td>0.89</td><td class="pos">0.64</td><td>24%</td><td><div class="progress"><i style="width:25%"></i></div>25%</td></tr><tr><td>In-house repairing &amp; part development</td><td>1.22</td><td class="pos">1.47</td><td>55%</td><td><div class="progress"><i style="width:57%"></i></div>57%</td></tr><tr><td>Total</td><td>3.62</td><td>2.65*</td><td>100%</td><td>102%*</td></tr></tbody></table><p class="note" style="margin:14px 0 0">*The supplied detail table totals 2.65 M$, while the stated headline target and achieved value are 2.60 M$. The dashboard preserves both figures for reconciliation.</p></div></section>
    <section class="section" id="actions"><div class="section-head"><div><h2>Major activities</h2><p>Reported savings initiatives supporting overhead expense control</p></div></div><div class="grid2"><article class="card"><h3>Expense-saving initiatives</h3><table><tbody><tr><td>KUKA Robot Controller spare parts</td><td class="pos">8 K$</td></tr><tr><td>Spare parts unit box (1–4) packing line machines</td><td class="pos">6.2 K$</td></tr><tr><td>H8 Cosmetic Viewer machine spare parts</td><td class="pos">4.3 K$</td></tr><tr><td>Testing SIM/PCB card for all models</td><td class="pos">5.4 K$</td></tr></tbody></table></article><article class="card"><h3>Navigation and source links</h3><p class="note">Internal links are active. Add your reporting URLs here before publishing.</p><div class="links"><a class="btn" href="#overview">Back to overview</a><a class="btn" href="#expense">Expense details</a><a class="btn" href="#projects">Project savings</a><a class="btn" href="mailto:?subject=O%2FH%20Expense%20Dashboard%20Jan%E2%80%93Aug%202026">Share by email</a></div></article></div></section>
    <footer>Source: management report screenshots supplied by the user · Static dashboard ready for web hosting</footer>
  </main>
  <script>
    Chart.defaults.font.family='Inter, Segoe UI, Arial, sans-serif'; Chart.defaults.color='#64748b'; const peach='#f6c6a2',blue='#8db7dc',deep='#1769aa',gray='#aeb7c4';
    const money=v=>v+' M$';
    new Chart(document.getElementById('planActual'),{type:'bar',data:{labels:['Product supply','Repair & maintenance','Total expense'],datasets:[{label:'M-Plan',data:[1.62,2.16,3.78],backgroundColor:peach,borderRadius:5},{label:'Actual',data:[1.47,1.30,2.77],backgroundColor:blue,borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'},tooltip:{callbacks:{label:c=>c.dataset.label+': '+money(c.raw)}}},scales:{y:{beginAtZero:true,ticks:{callback:money},grid:{color:'#edf2f7'}},x:{grid:{display:false}}}}});
    new Chart(document.getElementById('monthlyExpense'),{type:'line',data:{labels:['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug'],datasets:[{label:'M-Plan',data:[.31,.32,.45,.43,.58,.69,.50,.50],borderColor:peach,backgroundColor:peach,tension:.35,pointRadius:4},{label:'Actual',data:[.22,.34,.51,.53,.32,.23,.26,.36],borderColor:deep,backgroundColor:deep,tension:.35,pointRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'}},scales:{y:{beginAtZero:true,ticks:{callback:money},grid:{color:'#edf2f7'}},x:{grid:{display:false}}}}});
    new Chart(document.getElementById('cumulative'),{data:{labels:['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug'],datasets:[{type:'bar',label:'Cumulative saving',data:[.66,1.13,1.32,1.48,1.94,2.11,2.30,2.60],backgroundColor:blue,borderRadius:4},{type:'line',label:'Projects',data:[205,269,391,526,null,null,null,600],borderColor:'#f18b4d',pointRadius:4,yAxisID:'y1',tension:.25}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'}},scales:{y:{beginAtZero:true,ticks:{callback:money},grid:{color:'#edf2f7'}},y1:{position:'right',beginAtZero:true,grid:{drawOnChartArea:false},ticks:{callback:v=>v}},x:{grid:{display:false}}}}});
    new Chart(document.getElementById('categories'),{type:'doughnut',data:{labels:['In-house repairing & part development','Consumption reduction','Localization / Re-bidding'],datasets:[{data:[1.47,.64,.54],backgroundColor:['#f6c6a2','#aeb7c4','#a9c8e5'],borderColor:'#fff',borderWidth:3}]},options:{responsive:true,maintainAspectRatio:false,cutout:'57%',plugins:{legend:{position:'right'},tooltip:{callbacks:{label:c=>c.label+': '+money(c.raw)}}}}});
  </script>
</body></html>
